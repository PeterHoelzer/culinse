# Erzeugt von mail/bauen.mjs. Nicht von Hand ändern.
# Einstellungen des Anmeldedienstes (supabase-auth): Vorlagen und Betreffzeilen.
# Kommt auf dem Server nach /opt/supabase/mailer-culinse.env, siehe mail/LIESMICH.md.
GOTRUE_MAILER_TEMPLATES_CONFIRMATION=http://mailvorlagen/confirmation.html
GOTRUE_MAILER_SUBJECTS_CONFIRMATION="{{ if eq (printf `%v` .Data.locale) `de` }}Bestätige deine E-Mail-Adresse für Culinse{{ else if eq (printf `%v` .Data.locale) `es` }}Confirma tu correo electrónico en Culinse{{ else if eq (printf `%v` .Data.locale) `fr` }}Confirme ton adresse e-mail pour Culinse{{ else if eq (printf `%v` .Data.locale) `it` }}Conferma il tuo indirizzo e-mail per Culinse{{ else if eq (printf `%v` .Data.locale) `pl` }}Potwierdź swój adres e-mail w Culinse{{ else if eq (printf `%v` .Data.locale) `tr` }}Culinse için e-posta adresini onayla{{ else if eq (printf `%v` .Data.locale) `nl` }}Bevestig je e-mailadres voor Culinse{{ else if eq (printf `%v` .Data.locale) `cs` }}Potvrď svou e-mailovou adresu pro Culinse{{ else if eq (printf `%v` .Data.locale) `ru` }}Подтверди адрес почты для Culinse{{ else if eq (printf `%v` .Data.locale) `pt` }}Confirme seu e-mail no Culinse{{ else if eq (printf `%v` .Data.locale) `zh` }}请确认你在 Culinse 的邮箱地址{{ else if eq (printf `%v` .Data.locale) `ja` }}Culinseのメールアドレスを確認してください{{ else if eq (printf `%v` .Data.locale) `id` }}Konfirmasi alamat email kamu untuk Culinse{{ else if eq (printf `%v` .Data.locale) `vi` }}Xác nhận địa chỉ email của bạn cho Culinse{{ else if eq (printf `%v` .Data.locale) `bn` }}Culinse-এর জন্য আপনার ইমেইল ঠিকানা নিশ্চিত করুন{{ else }}Confirm your email address for Culinse{{ end }}"
GOTRUE_MAILER_TEMPLATES_RECOVERY=http://mailvorlagen/recovery.html
GOTRUE_MAILER_SUBJECTS_RECOVERY="{{ if eq .RedirectTo `https://culinse.com/en/update-password` }}New password for your Culinse account{{ else if eq .RedirectTo `https://culinse.com/de/update-password` }}Neues Passwort für dein Culinse-Konto{{ else if eq .RedirectTo `https://culinse.com/es/update-password` }}Nueva contraseña para tu cuenta de Culinse{{ else if eq .RedirectTo `https://culinse.com/fr/update-password` }}Nouveau mot de passe pour ton compte Culinse{{ else if eq .RedirectTo `https://culinse.com/it/update-password` }}Nuova password per il tuo account Culinse{{ else if eq .RedirectTo `https://culinse.com/pl/update-password` }}Nowe hasło do konta w Culinse{{ else if eq .RedirectTo `https://culinse.com/tr/update-password` }}Culinse hesabın için yeni şifre{{ else if eq .RedirectTo `https://culinse.com/nl/update-password` }}Nieuw wachtwoord voor je Culinse-account{{ else if eq .RedirectTo `https://culinse.com/cs/update-password` }}Nové heslo pro tvůj účet v Culinse{{ else if eq .RedirectTo `https://culinse.com/ru/update-password` }}Новый пароль для аккаунта в Culinse{{ else if eq .RedirectTo `https://culinse.com/pt/update-password` }}Nova senha para sua conta no Culinse{{ else if eq .RedirectTo `https://culinse.com/zh/update-password` }}为你的 Culinse 账户设置新密码{{ else if eq .RedirectTo `https://culinse.com/ja/update-password` }}Culinseアカウントの新しいパスワード{{ else if eq .RedirectTo `https://culinse.com/id/update-password` }}Kata sandi baru untuk akun Culinse kamu{{ else if eq .RedirectTo `https://culinse.com/vi/update-password` }}Mật khẩu mới cho tài khoản Culinse của bạn{{ else if eq .RedirectTo `https://culinse.com/bn/update-password` }}আপনার Culinse অ্যাকাউন্টের নতুন পাসওয়ার্ড{{ else if eq (printf `%v` .Data.locale) `de` }}Neues Passwort für dein Culinse-Konto{{ else if eq (printf `%v` .Data.locale) `es` }}Nueva contraseña para tu cuenta de Culinse{{ else if eq (printf `%v` .Data.locale) `fr` }}Nouveau mot de passe pour ton compte Culinse{{ else if eq (printf `%v` .Data.locale) `it` }}Nuova password per il tuo account Culinse{{ else if eq (printf `%v` .Data.locale) `pl` }}Nowe hasło do konta w Culinse{{ else if eq (printf `%v` .Data.locale) `tr` }}Culinse hesabın için yeni şifre{{ else if eq (printf `%v` .Data.locale) `nl` }}Nieuw wachtwoord voor je Culinse-account{{ else if eq (printf `%v` .Data.locale) `cs` }}Nové heslo pro tvůj účet v Culinse{{ else if eq (printf `%v` .Data.locale) `ru` }}Новый пароль для аккаунта в Culinse{{ else if eq (printf `%v` .Data.locale) `pt` }}Nova senha para sua conta no Culinse{{ else if eq (printf `%v` .Data.locale) `zh` }}为你的 Culinse 账户设置新密码{{ else if eq (printf `%v` .Data.locale) `ja` }}Culinseアカウントの新しいパスワード{{ else if eq (printf `%v` .Data.locale) `id` }}Kata sandi baru untuk akun Culinse kamu{{ else if eq (printf `%v` .Data.locale) `vi` }}Mật khẩu mới cho tài khoản Culinse của bạn{{ else if eq (printf `%v` .Data.locale) `bn` }}আপনার Culinse অ্যাকাউন্টের নতুন পাসওয়ার্ড{{ else }}New password for your Culinse account{{ end }}"
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=http://mailvorlagen/magic_link.html
GOTRUE_MAILER_SUBJECTS_MAGIC_LINK="{{ if eq (printf `%v` .Data.locale) `de` }}Dein Anmelde-Link für Culinse{{ else if eq (printf `%v` .Data.locale) `es` }}Tu enlace de acceso a Culinse{{ else if eq (printf `%v` .Data.locale) `fr` }}Ton lien de connexion pour Culinse{{ else if eq (printf `%v` .Data.locale) `it` }}Il tuo link di accesso per Culinse{{ else if eq (printf `%v` .Data.locale) `pl` }}Twój link do logowania w Culinse{{ else if eq (printf `%v` .Data.locale) `tr` }}Culinse giriş bağlantın{{ else if eq (printf `%v` .Data.locale) `nl` }}Je inloglink voor Culinse{{ else if eq (printf `%v` .Data.locale) `cs` }}Tvůj odkaz pro přihlášení do Culinse{{ else if eq (printf `%v` .Data.locale) `ru` }}Твоя ссылка для входа в Culinse{{ else if eq (printf `%v` .Data.locale) `pt` }}Seu link de acesso ao Culinse{{ else if eq (printf `%v` .Data.locale) `zh` }}你的 Culinse 登录链接{{ else if eq (printf `%v` .Data.locale) `ja` }}Culinseのログインリンク{{ else if eq (printf `%v` .Data.locale) `id` }}Tautan masuk kamu untuk Culinse{{ else if eq (printf `%v` .Data.locale) `vi` }}Liên kết đăng nhập Culinse của bạn{{ else if eq (printf `%v` .Data.locale) `bn` }}Culinse-এর জন্য আপনার লগ ইন লিংক{{ else }}Your sign-in link for Culinse{{ end }}"
GOTRUE_MAILER_TEMPLATES_EMAIL_CHANGE=http://mailvorlagen/email_change.html
GOTRUE_MAILER_SUBJECTS_EMAIL_CHANGE="{{ if eq (printf `%v` .Data.locale) `de` }}Bestätige deine neue E-Mail-Adresse für Culinse{{ else if eq (printf `%v` .Data.locale) `es` }}Confirma tu nuevo correo en Culinse{{ else if eq (printf `%v` .Data.locale) `fr` }}Confirme ta nouvelle adresse e-mail pour Culinse{{ else if eq (printf `%v` .Data.locale) `it` }}Conferma il nuovo indirizzo e-mail per Culinse{{ else if eq (printf `%v` .Data.locale) `pl` }}Potwierdź nowy adres e-mail w Culinse{{ else if eq (printf `%v` .Data.locale) `tr` }}Culinse için yeni e-posta adresini onayla{{ else if eq (printf `%v` .Data.locale) `nl` }}Bevestig je nieuwe e-mailadres voor Culinse{{ else if eq (printf `%v` .Data.locale) `cs` }}Potvrď novou e-mailovou adresu pro Culinse{{ else if eq (printf `%v` .Data.locale) `ru` }}Подтверди новый адрес почты для Culinse{{ else if eq (printf `%v` .Data.locale) `pt` }}Confirme seu novo e-mail no Culinse{{ else if eq (printf `%v` .Data.locale) `zh` }}请确认你在 Culinse 的新邮箱地址{{ else if eq (printf `%v` .Data.locale) `ja` }}Culinseの新しいメールアドレスを確認してください{{ else if eq (printf `%v` .Data.locale) `id` }}Konfirmasi alamat email baru untuk Culinse{{ else if eq (printf `%v` .Data.locale) `vi` }}Xác nhận địa chỉ email mới của bạn cho Culinse{{ else if eq (printf `%v` .Data.locale) `bn` }}Culinse-এর জন্য আপনার নতুন ইমেইল ঠিকানা নিশ্চিত করুন{{ else }}Confirm your new email address for Culinse{{ end }}"
GOTRUE_MAILER_TEMPLATES_INVITE=http://mailvorlagen/invite.html
GOTRUE_MAILER_SUBJECTS_INVITE="{{ if eq (printf `%v` .Data.locale) `de` }}Du bist zu Culinse eingeladen{{ else if eq (printf `%v` .Data.locale) `es` }}Te han invitado a Culinse{{ else if eq (printf `%v` .Data.locale) `fr` }}Une invitation pour toi sur Culinse{{ else if eq (printf `%v` .Data.locale) `it` }}Hai un invito per Culinse{{ else if eq (printf `%v` .Data.locale) `pl` }}Zaproszenie do Culinse{{ else if eq (printf `%v` .Data.locale) `tr` }}Culinse'ye davetlisin{{ else if eq (printf `%v` .Data.locale) `nl` }}Je bent uitgenodigd voor Culinse{{ else if eq (printf `%v` .Data.locale) `cs` }}Pozvánka do Culinse{{ else if eq (printf `%v` .Data.locale) `ru` }}Тебя приглашают в Culinse{{ else if eq (printf `%v` .Data.locale) `pt` }}Convite para entrar no Culinse{{ else if eq (printf `%v` .Data.locale) `zh` }}邀请你加入 Culinse{{ else if eq (printf `%v` .Data.locale) `ja` }}Culinseにご招待します{{ else if eq (printf `%v` .Data.locale) `id` }}Kamu diundang ke Culinse{{ else if eq (printf `%v` .Data.locale) `vi` }}Bạn được mời tham gia Culinse{{ else if eq (printf `%v` .Data.locale) `bn` }}আপনাকে Culinse-এ আমন্ত্রণ জানানো হয়েছে{{ else }}You are invited to Culinse{{ end }}"
GOTRUE_MAILER_TEMPLATES_REAUTHENTICATION=http://mailvorlagen/reauthentication.html
GOTRUE_MAILER_SUBJECTS_REAUTHENTICATION="{{ if eq (printf `%v` .Data.locale) `de` }}Dein Code für Culinse{{ else if eq (printf `%v` .Data.locale) `es` }}Tu código para Culinse{{ else if eq (printf `%v` .Data.locale) `fr` }}Ton code pour Culinse{{ else if eq (printf `%v` .Data.locale) `it` }}Il tuo codice per Culinse{{ else if eq (printf `%v` .Data.locale) `pl` }}Twój kod do Culinse{{ else if eq (printf `%v` .Data.locale) `tr` }}Culinse kodun{{ else if eq (printf `%v` .Data.locale) `nl` }}Je code voor Culinse{{ else if eq (printf `%v` .Data.locale) `cs` }}Tvůj kód pro Culinse{{ else if eq (printf `%v` .Data.locale) `ru` }}Твой код для Culinse{{ else if eq (printf `%v` .Data.locale) `pt` }}Seu código para o Culinse{{ else if eq (printf `%v` .Data.locale) `zh` }}你的 Culinse 验证码{{ else if eq (printf `%v` .Data.locale) `ja` }}Culinseの確認コード{{ else if eq (printf `%v` .Data.locale) `id` }}Kode kamu untuk Culinse{{ else if eq (printf `%v` .Data.locale) `vi` }}Mã của bạn cho Culinse{{ else if eq (printf `%v` .Data.locale) `bn` }}Culinse-এর জন্য আপনার কোড{{ else }}Your code for Culinse{{ end }}"
